<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_forward_auth_demo" model="res.groups">
            <field name="name">Forward Auth (example)</field>
            <field name="comment">Example group for odoo-forward-auth; loaded only in databases with demo data. Pick this group in General Settings to try the flow.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="category_id" ref="base.module_category_hidden" />
        </record>
        <record id="user_demo_forward_auth" model="res.users">
            <field name="name">Forward Auth Demo</field>
            <field name="login">demo.forward.auth</field>
            <field name="password">demo</field>
            <field name="groups_id" eval="[(4, ref('base.group_user')), (4, ref('group_forward_auth_demo'))]" />
        </record>
    </data>
</odoo>
